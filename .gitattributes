#importing required libraries from tkinter
from tkinter import *
import pygame
root = Tk()
root.title("MP3 player")
root.geonetry("500x300")
pygame.mixer.init()
#  initlalise the pygame
def play():
 pygame.mixer.music.load("uae-anthem")
 pygame.mixer.music.play(loops=0)
title=Label(root,text="MP3 Player Welcome",bd=9,relief=GROOVE,font=("times new romen",30,"bold"),bd="white",fg="green")
title.pack(side=TOP,fill=X)
play_button = Button(root, text="Start", font=("Helvetica", 32), command=play)
play_button.pack(pady=20)
root.mainloop()

import pygame
from tkinter import *

root = Tk()
root.title("shamma-9-adv")
root.geometry("500x300")
pygame.mixer.init()

def play():
    pygame.mixer.music.load("uae-anthem.mp3")
    pygame.mixer.music.play(loops=0)

title = Label(root, text="MP3 Player Welcome", bd=9, relief=GROOVE, 
              font=("times new roman", 30, "bold"), bg="white", fg="green")
title.pack(side=TOP, fill=X)

# This creates your Start button
play_button = Button(root, text="Start", font=("Helvetica", 32), command=play)
play_button.pack(pady=20)

# IMPORTANT: This must be at the very bottom and NOT indented
root.mainloop()
